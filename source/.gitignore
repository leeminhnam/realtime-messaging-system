# ==========================================
# 1. Java Compiled & Build Outputs
# ==========================================
*.class
*.jar
*.war
*.ear
bin/
out/
build/
target/
dist/

# Giữ lại các file jar thư viện trong source/lib/
!lib/*.jar

# ==========================================
# 2. SQLite Database Files (Server Data)
# ==========================================
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3
server/data/*
!server/data/.gitkeep
data/*
!data/.gitkeep

# ==========================================
# 3. File Transfers & Uploads / Downloads
# ==========================================
uploads/
downloads/
temp/
tmp/
*.tmp
server/uploads/*
!server/uploads/.gitkeep
client/downloads/*
!client/downloads/.gitkeep

# ==========================================
# 4. IDE / Editor Configurations
# ==========================================
.vscode/*
!.vscode/settings.json
*.code-workspace
.idea/
*.iml
*.iws
*.ipr
.classpath
.project
.settings/
.metadata/
nbproject/private/
nbbuild/
nbdist/

# ==========================================
# 5. OS Temp, Crash Dumps & System Files
# ==========================================
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# Logs & Dumps
*.log
logs/
hs_err_pid*
replay_pid*
*.hprof
